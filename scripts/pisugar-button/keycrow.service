[Unit]
Description=KeyCrow auto-start
After=multi-user.target
Wants=pisugar-server.service
After=pisugar-server.service

[Service]
Type=simple
User=root
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/keycrow
WorkingDirectory=/home/keycrow/keycrow
ExecStartPre=/bin/sleep 5
ExecStart=/home/keycrow/keycrow/venv/bin/python /home/keycrow/keycrow/keycrow.py
StandardOutput=append:/tmp/keycrow.log
StandardError=append:/tmp/keycrow.log
Restart=no

[Install]
WantedBy=multi-user.target
